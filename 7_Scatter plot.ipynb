   "source": [
    "#Scatter Plot\n",
    "# importing matplotlib module\n",
    "from matplotlib import pyplot as plt\n",
    "\n",
    "# x-axis values\n",
    "x = [5, 2, 9, 4, 7, 3, 8, 10, 1]\n",
    "\n",
    "# Y-axis values\n",
    "y = [10, 5, 8, 4, 2, 1, 6, 3, 9]\n",
    "\n",
    "# Function to plot scatter\n",
    "plt.scatter(x, y)\n",
    "\n",
    "# function to show the plot\n",
    "plt.show()\n"
   ]
